moo-hostname=moo.example.org
moo-port=5555
moo-user=your_username
moo-password=your_password
moo-idle-ms=1000
moo-first-response-timeout-ms=2000

# MCP server runtime mode:
# - stdio (default): existing behavior; process is spawned and uses stdio transport.
# - http_shared: local daemon over Streamable HTTP for multiple local agents sharing one MOO session/queue.
mcp-mode=stdio

# Used only when mcp-mode=http_shared.
# Localhost-only values are enforced for safety.
mcp-http-host=127.0.0.1
mcp-http-port=3000

# Optional extra tools (path relative to the process working directory).
# Pick one tracked profile, or point to your own configuration.
# moo-tools-config=config/toaststunt-llm-lab.tools.json
# moo-tools-config=config/sindome.tools.json
# moo-tools-config=config/sindome-compat.tools.json
# moo-tools-config=config/combined.tools.json
